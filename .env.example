# Firebase Realtime Database Config
# Create a free project at https://console.firebase.google.com
# 1. Click "Build" -> "Realtime Database" -> "Create Database" (Select region: Singapore/asia-southeast1)
# 2. In Rules tab, set:
#    {
#      "rules": {
#        ".read": true,
#        ".write": true
#      }
#    }
# 3. In Project Settings -> "Your apps" -> Web app (</>) -> copy values below:

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
